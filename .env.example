# OpenAI-compatible chat completion
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://example.com/v1
OPENAI_MODEL=deepseek-v4-flash

# Embedding service (online by default)
EMBEDDING_API_KEY=sk-xxx
EMBEDDING_BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding

# Replace the values above when switching to the local embedding service:
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=http://127.0.0.1:11434
# EMBEDDING_MODEL=qwen3-embedding:0.6b

# Rerank model on OpenRouter (Cohere-compatible /rerank API)
RERANK_API_KEY=sk-or-v1-xxx
RERANK_BASE_URL=https://openrouter.ai/api/v1
RERANK_MODEL=cohere/rerank-4-pro

# MySQL connection used by src/tool/use_tools_query_sql.py
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=rag
